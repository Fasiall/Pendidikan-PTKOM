# Salin file ini menjadi .env lalu isi nilainya
PORT=3000
NODE_ENV=development

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=rahasia-kuis-sd
PG_DATABASE=pendidikan_ptkom
PG_DATA_DIR=.pgdata
PG_VERBOSE=false

JWT_SECRET=isi-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=1d

SESSION_SECRET=isi-dengan-string-acak-lain

# Google OAuth 2.0 / Google Identity Services
GOOGLE_CLIENT_ID=isi-dengan-client-id-google-anda.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=isi-dengan-client-secret-google-anda
GOOGLE_PROJECT_ID=isi-dengan-project-id-google-anda

# Email SMTP (Nodemailer) untuk Verifikasi OTP
# (Opsional di development: jika kosong, kode OTP dicetak di terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email-anda@gmail.com
SMTP_PASS=app-password-16-karakter
EMAIL_FROM="Kuis Petualangan Ceria <no-reply@kuisceria.id>"
