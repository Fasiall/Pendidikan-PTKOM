# Salin file ini menjadi .env lalu isi nilainya (file .env sudah masuk .gitignore)
PORT=3000
NODE_ENV=development

# Database PostgreSQL Eksternal (Production / Cloud seperti Neon / Supabase)
# Jika dikosongkan, otomatis memakai PostgreSQL embedded lokal
DATABASE_URL=

# Database PostgreSQL Lokal / Embedded
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=rahasia-kuis-sd
PG_DATABASE=pendidikan_ptkom
PG_DATA_DIR=.pgdata
PG_VERBOSE=false

# Keamanan JWT & Sesi (WAJIB diganti dengan string acak di production)
JWT_SECRET=isi-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=1d
SESSION_SECRET=isi-dengan-string-acak-lain

# Akun Guru Awal (Seed)
SEED_TEACHER_USERNAME=guru
SEED_TEACHER_PASSWORD=ganti-password-guru

# Email SMTP (Nodemailer) untuk Verifikasi OTP
# (Opsional di development: jika kosong, kode OTP dicetak di terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email-anda@gmail.com
SMTP_PASS=app-password-16-karakter
EMAIL_FROM="Kuis Petualangan Ceria <no-reply@kuisceria.id>"
